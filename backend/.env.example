# Copy to .env for local development. Never commit .env.
# On Cloud Run, set these as environment variables / secrets instead.

PORT=8080
FIREBASE_PROJECT_ID=tapngo-4bed6

# Local only: path to a service account key downloaded from
# Firebase console > Project settings > Service accounts.
# (Not needed on Cloud Run, which uses its own service account.)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# Long random strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_PEPPER=
RUN_SECRET=

# Google sign-in: Firebase console > Authentication > Sign-in method > Google >
# "Web SDK configuration" > Web client ID (ends in .apps.googleusercontent.com).
GOOGLE_CLIENT_ID=

# Gmail sender. EMAIL_PASS is an app password (not your login password):
# turn on 2-step verification, then create one at https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=
