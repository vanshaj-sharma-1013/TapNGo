// Paste into Firebase console > Firestore Database > Rules, then Publish.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // One document per player, named after their uid. Anyone can read the board.
    // Only the backend writes it (the Admin SDK ignores these rules), after checking the
    // score is plausible. Every other collection (e.g. otp) is closed to clients.
    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if false;
    }
  }
}
